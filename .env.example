# Portkey API Configuration
# Get your PORTKEY_API_KEY from https://portkey.ai/
PORTKEY_API_KEY=your_portkey_api_key_here

# Optional: Specify a different database path (defaults to ~/Downloads/data\ 2/campus_customs.db)
# DATABASE_PATH=/path/to/your/campus_customs.db

# Optional: Specify a different products image directory (defaults to ~/Downloads/data\ 2/products)
# PRODUCTS_PATH=/path/to/your/products/images
